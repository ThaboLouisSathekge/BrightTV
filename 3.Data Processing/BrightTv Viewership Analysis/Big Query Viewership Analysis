WITH user_profiles AS 
(SELECT UserID,
        Province,
        ---Inspecting the Province column
        CASE WHEN Province=' ' THEN 'Uncategorized' ---replacing empty space with Uncategorized
            WHEN Province='None' THEN 'Uncategorized'---replacing None with Uncategorized
            WHEN Province IS NULL THEN 'Uncategorized' ---replacing NULL with Uncategorized
            ELSE Province
            END AS Region,
age,
        ---Inspecting the age column
        CASE
            WHEN age = 0 THEN 'Infants'
            WHEN age BETWEEN 1 AND 12 THEN 'Kids'
            WHEN age BETWEEN 13 AND 19 THEN 'Teenager'
            WHEN age BETWEEN 20 AND 35 THEN 'Youth'
            WHEN age BETWEEN 36 AND 50 THEN 'Adult'
            WHEN age BETWEEN 51 AND 65 THEN 'Elder'
            WHEN age >65 THEN 'Pensioner'
            END AS age_groups,

    ---counting the number of users who have email addresses 
    Email,
        CASE
            WHEN Email IS NOT NULL 
            OR Email=' ' 
            OR Email NOT IN ('None')THEN 1 ---the subcriber has an email address listed
            ELSE 0   ----the subscriber does not have any email listed
            END AS email_flag,
            
       `Social Media Handle`,
---counting the number of users who have `social media handles`
        CASE
             WHEN (`Social Media Handle` IS NOT NULL) 
             OR (`Social Media Handle` = ' ') 
             OR (`Social Media Handle` NOT IN ('None')) THEN 1  ---the subcriber has a social media handle listed
            ELSE 0 ----the subscriber does not have any social media handle listed
            END AS sm_flag,

    ---checking on the race column to replace Other and blank spaces with None
        CASE
        WHEN Race='other' THEN 'None'
        WHEN Race=' ' THEN 'None'
        ELSE Race
            END AS Ethnicity,

---Checking that each subsriber has a gender . If not , then we replacing blank spaces with None
        CASE
            WHEN gender =' ' THEN 'None'
            ELSE gender
            END AS Gender

FROM bright_tv1.data_1.userprofiles
),

viewership AS (
SELECT
COALESCE(UserID0,userid4) AS userid,
TO_CHAR(RecordDate2, 'yyyyMM') AS month_id,
TO_DATE(RecordDate2) AS watch_date,
--TIME(RecordDate2) AS watch_time,
TO_CHAR(RecordDate2, 'DD') AS day_of_dataset,
DAYNAME(RecordDate2) AS day_name,
CASE
WHEN day_name IN ('Sat', 'Sun') THEN 'weekend'
ELSE 'weekday'
END AS day_classification,
MONTHNAME(RecordDate2) AS month_name,
CASE
WHEN Channel2 IN ('SawSee','Sawsee') THEN 'SawSee'
WHEN Channel2 IN ('SuperSport Live Events','Live on SuperSport', 'Supersport Live Events',
'DStv Events 1') THEN 'Live Events'
ELSE Channel2
END AS Tv_channel,date_format(RecordDate2, 'HH:mm:ss') AS watch_time,
CASE
WHEN watch_time BETWEEN '00:00:00' AND '05:59:59' THEN '01. Midnight'
WHEN watch_time BETWEEN '06:00:00' AND '11:59:59' THEN '02. Morning'
WHEN watch_time BETWEEN '12:00:00' AND '16:59:59' THEN '03. Afternoon'
WHEN watch_time BETWEEN '17:00:00' AND '23:59:59' THEN '04. Evening'
END AS time_of_day,
DATE_FORMAT(`Duration 2`, 'HH:mm:ss') AS Duration,--converting duration into time format
(HOUR(TO_TIMESTAMP(`Duration 2`, 'HH:mm:ss')) +
 MINUTE(TO_TIMESTAMP(`Duration 2`, 'HH:mm:ss')) / 60.0 + --converting minutes to seconds
 SECOND(TO_TIMESTAMP(`Duration 2`, 'HH:mm:ss')) / 3600.0--converting seconds to minutes
) AS Duration_hours, 

(HOUR(TO_TIMESTAMP(`Duration 2`, 'HH:mm:ss')) * 3600 + --converting hours to seconds
 MINUTE(TO_TIMESTAMP(`Duration 2`, 'HH:mm:ss')) * 60 + ---converting minutes to seconds
SECOND(TO_TIMESTAMP(`Duration 2`, 'HH:mm:ss'))) AS Duration_seconds,

CASE
WHEN `Duration 2` BETWEEN '00:05:00' AND '00:30:00' THEN '01. Low Usage: <30 min'
WHEN `Duration 2` BETWEEN '00:30:01' AND '00:59:59' THEN '02. Med Usage: <60 min'
WHEN `Duration 2` > '00:59:59' THEN '03. High Usage: >60 min'
ELSE '04. No Usage'
END AS screen_time_bucket,
HOUR(RecordDate2) AS hour_of_day
FROM bright_tv1.data_1.viewership
)
SELECT Coalesce(A.userid,B.UserID) AS sub_id,
month_id,
watch_date,
day_of_dataset,
day_name,
day_classification,
month_name,
Tv_channel,
time_of_day,
hour_of_day,
screen_time_bucket,
--user_flag,
Duration,
Duration_hours,
Duration_seconds,
Region,
age_groups,
email_flag,
sm_flag,
Ethnicity,
Gender
FROM viewership AS A
LEFT JOIN user_profiles AS B
ON A.userid = B.UserID;
